# Google Gemini API key for AI job details extraction (Optional, regex fallback will be used if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Hunter.io API key for verifying recruiter emails and names (Optional - free tier available at hunter.io)
HUNTER_API_KEY=your_hunter_api_key_here

# Default job search settings tailored for Rutik Patil
DEFAULT_SEARCH_KEYWORDS=Data Engineer, Backend Engineer, Python Developer
DEFAULT_SEARCH_LOCATION=India
DEFAULT_MAX_JOBS=50
