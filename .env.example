# Google Gemini API key for AI job details extraction (Optional, regex fallback will be used if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Hunter.io API key for verifying recruiter emails and names (Optional - free tier available at hunter.io)
HUNTER_API_KEY=your_hunter_api_key_here

# Gmail Configuration for Drafting Application Emails
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
RESUME_PATH=resume.pdf

# Default job search settings tailored for Rutik Patil
DEFAULT_TOTAL_JOBS=50
DEFAULT_INDIA_JOBS=40
DEFAULT_INTL_BIG_TECH_JOBS=10
